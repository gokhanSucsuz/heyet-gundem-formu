# MongoDB Atlas bağlantı URI'si
MONGODB_URI=mongodb+srv://username:password@cluster.xxxxx.mongodb.net/heyet-gundem?retryWrites=true&w=majority

# Şifreleme Anahtarı (32 byte hex — openssl rand -hex 32 ile oluşturun)
ENCRYPTION_KEY=your-32-byte-hex-key-here

# Şifreleme Salt (16 byte hex — openssl rand -hex 16 ile oluşturun)
ENCRYPTION_SALT=your-16-byte-hex-salt-here

# NextAuth
NEXTAUTH_SECRET=your-nextauth-secret-here
NEXTAUTH_URL=http://localhost:3000

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
